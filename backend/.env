# Copy to backend/.env and adjust. Never commit the real .env.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-generate-with-python-secrets-token_urlsafe-50
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
DJANGO_ADMIN_URL=admin/

POSTGRES_DB=xpressdrive
POSTGRES_USER=xpressdrive
POSTGRES_PASSWORD=widest-dev-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

FRONTEND_URL=http://localhost:5173
# Only needed when web is served from a different site than the API:
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

